      <guid>http://localhost:1313/zh/contact/</guid>
      <description>&lt;section class=&#34;lg:pb-24&#34;&gt;&#xA;  &lt;div class=&#34;max-w-screen-md px-4 mx-auto&#34;&gt;&#xA;      &lt;p class=&#34;mb-8 font-light text-center text-gray-500 lg:mb-16 dark:text-gray-400 sm:text-xl&#34;&gt;&#xA;        有翻译需求？想咨询服务或获取报价？欢迎随时与我们联系。&#xA;&lt;div class=&#34;flex justify-center my-4&#34;&gt;&#xA;  &lt;img src=&#34;http://localhost:1313/images/featured/featured-img-placeholder.png&#34; alt=&#34;Contact&#34; width=&#34;80&#34; class=&#34;rounded-lg shadow-lg&#34; /&gt;&#xA;&lt;/div&gt;&#xA;      &lt;/p&gt;&#xA;      &lt;form name=&#34;contact&#34; action=&#34;https://formsubmit.co/clara@xf-trans.com&#34; method=&#34;POST&#34; class=&#34;space-y-8&#34;&gt;&#xA;          &lt;input type=&#34;hidden&#34; name=&#34;_next&#34; value=&#34;https://xf-trans.com/thanks&#34;&gt;&#xA;          &lt;div class=&#34;my-4&#34;&gt;&#xA;              &lt;label for=&#34;email&#34; class=&#34;block mb-2 font-medium text-gray-900 text-md dark:text-gray-300&#34;&gt;&lt;strong&gt;您的邮箱：&lt;/strong&gt;&lt;/label&gt;&#xA;              &lt;input type=&#34;email&#34; name=&#34;email&#34; required class=&#34;shadow-sm bg-gray-50 border border-gray-300 text-gray-900 text-md rounded-lg block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white&#34; placeholder=&#34;name@example.com&#34;&gt;&#xA;          &lt;/div&gt;&#xA;          &lt;div class=&#34;my-4&#34;&gt;&#xA;              &lt;label for=&#34;subject&#34; class=&#34;block mb-2 font-medium text-gray-900 text-md dark:text-gray-300&#34;&gt;&lt;strong&gt;主题：&lt;/strong&gt;&lt;/label&gt;&#xA;              &lt;input type=&#34;text&#34; name=&#34;subject&#34; required class=&#34;block w-full p-3 text-gray-900 border border-gray-300 rounded-lg bg-gray-50 dark:bg-gray-700 dark:border-gray-600 dark:text-white&#34; placeholder=&#34;如：翻译服务咨询&#34;&gt;&#xA;          &lt;/div&gt;&#xA;          &lt;div class=&#34;my-4 sm:col-span-2&#34;&gt;&#xA;              &lt;label for=&#34;message&#34; class=&#34;block mb-2 font-medium text-gray-900 text-md dark:text-gray-400&#34;&gt;&lt;strong&gt;留言内容：&lt;/strong&gt;&lt;/label&gt;&#xA;              &lt;textarea id=&#34;message&#34; name=&#34;message&#34; rows=&#34;6&#34; required class=&#34;block p-2.5 w-full text-md text-gray-900 bg-gray-50 rounded-lg border border-gray-300 dark:bg-gray-700 dark:border-gray-600 dark:text-white&#34; placeholder=&#34;请描述您的翻译需求...&#34;&gt;&lt;/textarea&gt;&#xA;          &lt;/div&gt;&#xA;          &lt;div class=&#34;mt-6 lg:pb-16&#34;&gt;&#xA;             &lt;button type=&#34;submit&#34; class=&#34;px-5 py-3 font-bold text-white bg-indigo-600 rounded-lg hover:bg-indigo-800 dark:bg-indigo-600 dark:hover:bg-indigo-700&#34;&gt;发送信息&lt;/button&gt;&#xA;          &lt;/div&gt;&#xA;      &lt;/form&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/section&gt;</description>
